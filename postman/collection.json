{
  "info": {
    "name": "TierFlow API Collection",
    "description": "Complete REST API collection for TierFlow investment and referral platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Smith\",\n  \"email\": \"jane@tierflow.com\",\n  \"mobileNumber\": \"+919876543220\",\n  \"password\": \"password123\",\n  \"referralCode\": \"TFL123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('authToken', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"Aman@tierflow.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Investments",
      "item": [
        {
          "name": "Get Available Plans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/investments/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "investments",
                "plans"
              ]
            }
          }
        },
        {
          "name": "Create Investment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"growth-b\",\n  \"amount\": 25000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/investments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "investments"
              ]
            }
          }
        },
        {
          "name": "Get User Investments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/investments?status=All&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "investments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "All"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Get Dashboard Earnings Chart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/earnings?period=30d",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "earnings"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "30d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ROI History",
      "item": [
        {
          "name": "Get ROI History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/roi-history?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roi-history"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Trigger Daily ROI (Dev/Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2024-10-30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roi-history/process-daily",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roi-history",
                "process-daily"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Referrals",
      "item": [
        {
          "name": "Get Direct Referrals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/referrals/direct",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "referrals",
                "direct"
              ]
            }
          }
        },
        {
          "name": "Get Complete Referral Tree",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/referrals/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "referrals",
                "tree"
              ]
            }
          }
        },
        {
          "name": "Get Referral Income History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/referrals/income?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "referrals",
                "income"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}